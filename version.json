<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif;
    background:
      radial-gradient(circle at top, rgba(49, 130, 206, .18), transparent 32%),
      linear-gradient(180deg, #0b1020 0%, #111827 100%);
    color: #e5edf7;
    min-height: 100vh;
    padding: 28px 16px 40px;
  }

  .page {
    max-width: 1180px;
    margin: 0 auto;
  }

  .hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
  }

  .hero-text h1 {
    font-size: 1.9rem;
    color: #8ec5ff;
    margin-bottom: 8px;
    letter-spacing: 1px;
  }

  .hero-text p {
    color: #96a6bf;
    font-size: .95rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 18px;
    padding: 14px;
    background: rgba(15, 23, 42, .72);
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 14px;
    backdrop-filter: blur(8px);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 9px 16px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    color: #fff;
    text-decoration: none;
    font-size: .9rem;
    font-weight: 600;
    transition: transform .12s ease, opacity .15s ease, background .15s ease;
    white-space: nowrap;
  }

  .btn:hover { opacity: .92; }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: #2563eb; }
  .btn-primary:hover { background: #1d4ed8; }
  .btn-success { background: #059669; }
  .btn-success:hover { background: #047857; }
  .btn-ghost {
    background: rgba(148, 163, 184, .12);
    color: #dbeafe;
    border: 1px solid rgba(148, 163, 184, .24);
  }
  .btn-ghost:hover { background: rgba(148, 163, 184, .2); }
  .btn-sm { padding: 6px 12px; font-size: .82rem; }

  .counter {
    margin-left: auto;
    color: #94a3b8;
    font-size: .86rem;
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, .18);
    box-shadow: 0 24px 60px rgba(0, 0, 0, .28);
    background: rgba(15, 23, 42, .84);
    backdrop-filter: blur(12px);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    min-width: 760px;
  }

  thead th {
    text-align: left;
    padding: 14px 16px;
    color: #9fb4d1;
    font-size: .84rem;
    font-weight: 700;
    background: rgba(30, 41, 59, .92);
    position: sticky;
    top: 0;
    z-index: 1;
  }

  tbody tr { border-top: 1px solid rgba(51, 65, 85, .9); }
  tbody tr:hover { background: rgba(30, 41, 59, .72); }

  td {
    padding: 14px 16px;
    vertical-align: middle;
    font-size: .9rem;
  }

  .td-index {
    width: 60px;
    text-align: center;
    color: #64748b;
  }

  .td-name {
    min-width: 220px;
    font-weight: 600;
  }

  .url-text {
    display: inline-block;
    max-width: 100%;
    color: #7dd3fc;
    font-family: Consolas, 'Courier New', monospace;
    font-size: .84rem;
    line-height: 1.6;
    word-break: break-all;
  }

  .td-status {
    width: 150px;
    text-align: center;
    white-space: nowrap;
  }

  .td-action {
    width: 170px;
    white-space: nowrap;
  }

  .td-action .btn { margin-right: 6px; }
  .status-ok { color: #4ade80; font-size: .8rem; }
  .status-fail { color: #f87171; font-size: .8rem; }
  .status-none { color: #64748b; font-size: .8rem; }
  .status-checking { color: #fbbf24; font-size: .8rem; }
  .spin { display: inline-block; animation: spin .8s linear infinite; }

  .empty {
    padding: 48px 24px;
    text-align: center;
    color: #94a3b8;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  @media (max-width: 720px) {
    body { padding: 20px 12px 28px; }
    .hero { flex-direction: column; }
    .toolbar { padding: 12px; }
    .counter { width: 100%; margin-left: 0; }
  }
</style>
</head>
