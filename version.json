<script>
function getRowUrl(row) {
  return row.dataset.url ? row.dataset.url.trim() : '';
}

async function checkRowUrl(row, url) {
  const cell = row.querySelector('.status-cell');
  if (!cell) return;
  cell.innerHTML = '<span class="status-checking"><span class="spin">↻</span> 检测中…</span>';

  const formData = new FormData();
  formData.append('action', 'check_url');
  formData.append('url', url);

  try {
    const response = await fetch('', { method: 'POST', body: formData });
    const text = await response.text();
    let data;
    try {
      data = JSON.parse(text);
    } catch (error) {
      throw new Error(text || 'Invalid JSON');
    }
    if (data.status === 'ok') {
      cell.innerHTML = `<span class="status-ok">● ${data.code}&nbsp;&nbsp;${data.ms}ms</span>`;
    } else {
      const label = data.code ? data.code : (data.msg || '失败');
      cell.innerHTML = `<span class="status-fail">● ${label}</span>`;
    }
  } catch (error) {
    cell.innerHTML = '<span class="status-fail">● 请求错误</span>';
  }
}

function checkUrl(btn) {
  const row = btn.closest('tr');
  const url = getRowUrl(row);
  if (!url) {
    alert('URL 为空');
    return;
  }
  checkRowUrl(row, url);
}

function copyUrl(btn) {
  const row = btn.closest('tr');
  const url = getRowUrl(row);
  if (!url) {
    alert('URL 为空');
    return;
  }

  const onSuccess = () => {
    const originalText = btn.textContent;
    btn.textContent = '已复制';
    setTimeout(() => {
      btn.textContent = originalText;
    }, 1500);
  };

  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(url).then(onSuccess);
    return;
  }

  const textarea = document.createElement('textarea');
  textarea.value = url;
  textarea.style.cssText = 'position:fixed;opacity:0;pointer-events:none;';
  document.body.appendChild(textarea);
  textarea.select();
  document.execCommand('copy');
  document.body.removeChild(textarea);
  onSuccess();
}

async function checkAll() {
  const rows = Array.from(document.querySelectorAll('#tbody tr[data-url]'));
  if (!rows.length) {
    alert('没有可检测的 URL');
    return;
  }

  const concurrency = 5;
  let currentIndex = 0;

  async function runNext() {
    if (currentIndex >= rows.length) {
      return;
    }

    const row = rows[currentIndex++];
    const url = getRowUrl(row);
    if (url) {
      await checkRowUrl(row, url);
    }
    await runNext();
  }

  await Promise.all(Array(Math.min(concurrency, rows.length)).fill(null).map(runNext));
}
</script>

